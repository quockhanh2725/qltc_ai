<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Đăng nhập — Ví Thông Minh</title>
    <link rel="stylesheet" href="~/user/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/user/css/login.css" asp-append-version="true">
</head>
<body class="auth-body">

    <div class="auth-wrap">

        <!-- LEFT PANEL -->
        <div class="auth-left">
            <div class="auth-left-inner">
                <a class="auth-logo" href="#">
                    <div class="auth-logo-icon">💰</div>
                    <div>
                        <div class="auth-logo-text">Ví<em>Thông</em>Minh</div>
                        <div class="auth-logo-tag">Quản lý tài chính thông minh</div>
                    </div>
                </a>

                <div class="auth-hero">
                    <h1>Kiểm soát<br>tài chính<br><em>thông minh hơn</em></h1>
                    <p>Theo dõi chi tiêu, lập ngân sách và đạt mục tiêu tài chính với sự hỗ trợ của AI.</p>
                </div>

                <div class="auth-features">
                    <div class="auth-feat">
                        <div class="auth-feat-icon" style="background:rgba(79,70,229,.18)">🤖</div>
                        <div>
                            <div class="auth-feat-title">AI Phân loại tự động</div>
                            <div class="auth-feat-sub">Nhập chi tiêu, AI tự nhận diện danh mục</div>
                        </div>
                    </div>
                    <div class="auth-feat">
                        <div class="auth-feat-icon" style="background:rgba(34,197,94,.15)">📊</div>
                        <div>
                            <div class="auth-feat-title">Báo cáo trực quan</div>
                            <div class="auth-feat-sub">Biểu đồ chi tiêu theo tháng, năm</div>
                        </div>
                    </div>
                    <div class="auth-feat">
                        <div class="auth-feat-icon" style="background:rgba(245,158,11,.15)">🎯</div>
                        <div>
                            <div class="auth-feat-title">Quản lý ngân sách</div>
                            <div class="auth-feat-sub">Đặt hạn mức, cảnh báo khi gần vượt</div>
                        </div>
                    </div>
                    <div class="auth-feat">
                        <div class="auth-feat-icon" style="background:rgba(99,102,241,.15)">🔒</div>
                        <div>
                            <div class="auth-feat-title">Bảo mật tuyệt đối</div>
                            <div class="auth-feat-sub">Mã hóa dữ liệu, xác thực 2 lớp</div>
                        </div>
                    </div>
                </div>

                <div class="auth-stats">
                    <div class="auth-stat">
                        <div class="auth-stat-val">12K+</div>
                        <div class="auth-stat-lbl">Người dùng</div>
                    </div>
                    <div class="auth-stat">
                        <div class="auth-stat-val" style="color:#4ade80">98%</div>
                        <div class="auth-stat-lbl">Hài lòng</div>
                    </div>
                    <div class="auth-stat">
                        <div class="auth-stat-val" style="color:#fbbf24">4.9★</div>
                        <div class="auth-stat-lbl">Đánh giá</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="auth-right">

            <!-- Tab switcher -->
            <div class="auth-tabs">
                <button class="auth-tab active" id="tab-login">🔒 Đăng nhập</button>
                <button class="auth-tab" id="tab-register">✨ Đăng ký</button>
            </div>

            <!-- FORMS CONTAINER -->
            <div class="auth-forms-wrap">

                <!-- LOGIN FORM -->
                <div class="auth-form-panel active" id="panel-login">
                    <div class="auth-form-head">
                        <h2>Chào mừng trở lại 👋</h2>
                        <p>Đăng nhập để quản lý tài chính của bạn</p>
                    </div>
                    <div class="auth-field">
                        <label>EMAIL</label>
                        <input type="text" placeholder="email@example.com" autocomplete="email">
                    </div>
                    <div class="auth-field">
                        <label>MẬT KHẨU</label>
                        <div class="auth-pw-wrap">
                            <input type="password" id="pw-login" placeholder="Tối thiểu 6 ký tự" autocomplete="current-password">
                            <button class="auth-pw-eye" data-target="pw-login">👁</button>
                        </div>
                    </div>
                    <button class="auth-btn primary" id="btn-login">Đăng nhập</button>
                    <p class="auth-switch">Chưa có tài khoản? <button class="auth-link-btn" id="go-register">Đăng ký miễn phí →</button></p>
                </div>

                <!-- REGISTER FORM -->
                <div class="auth-form-panel" id="panel-register">

                   
                    <div id="register-step-1">
                        <div class="auth-form-head">
                            <h2>Tạo tài khoản mới ✨</h2>
                            <p>Miễn phí · Không cần thẻ tín dụng</p>
                        </div>
                        <div class="auth-field">
                            <label>EMAIL</label>
                            <input type="email" id="reg-email" placeholder="email@example.com" autocomplete="email">
                        </div>
                        <div class="auth-field">
                            <label>MẬT KHẨU</label>
                            <div class="auth-pw-wrap">
                                <input type="password" id="pw-reg" placeholder="Tối thiểu 8 ký tự">
                                <button class="auth-pw-eye" data-target="pw-reg">👁</button>
                            </div>
                            <div class="pw-strength-bar"><div class="pw-strength-fill" id="pw-strength-fill"></div></div>
                        </div>
                        <label class="auth-check" style="font-size:11px;margin-bottom:10px">
                            <input type="checkbox" id="reg-terms"> Tôi đồng ý với <a href="#" style="color:#6366f1">Điều khoản dịch vụ</a> và <a href="#" style="color:#6366f1">Chính sách riêng tư</a>
                        </label>
                        <button class="auth-btn primary" id="btn-register"> Tạo tài khoản</button>
                        <p class="auth-switch">Đã có tài khoản? <button class="auth-link-btn" id="go-login">Đăng nhập →</button></p>
                    </div>

                    
                    <div id="register-step-2" style="display:none">
                        <div class="auth-form-head">
                            <h2>Xác nhận email 📧</h2>
                            <p id="otp-hint">Nhập mã OTP 6 số đã gửi đến email của bạn</p>
                        </div>
                        <div class="auth-field">
                            <label>MÃ XÁC NHẬN OTP</label>
                            <div class="otp-input-wrap">
                                <input type="text" id="otp-box-1" class="otp-box" maxlength="1" inputmode="numeric">
                                <input type="text" id="otp-box-2" class="otp-box" maxlength="1" inputmode="numeric">
                                <input type="text" id="otp-box-3" class="otp-box" maxlength="1" inputmode="numeric">
                                <input type="text" id="otp-box-4" class="otp-box" maxlength="1" inputmode="numeric">
                                <input type="text" id="otp-box-5" class="otp-box" maxlength="1" inputmode="numeric">
                                <input type="text" id="otp-box-6" class="otp-box" maxlength="1" inputmode="numeric">
                            </div>
                        </div>
                        <button class="auth-btn primary" id="btn-verify">✅ Xác nhận</button>
                        <p class="auth-switch">
                            Không nhận được mã? <button class="auth-link-btn" id="btn-resend">Gửi lại OTP</button>
                        </p>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <script src="~/user/js/login.js" asp-append-version="true"></script>
</body>
</html>
